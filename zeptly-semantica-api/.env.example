# zeptly-semantica-api configuration. Copy to .env for local docker compose.
# Never commit real values.

# production | staging | development | test  (unset = production)
SEMANTICA_ENV=development

# Shared server-to-server key; callers send it as the X-API-Key header.
# Required unless SEMANTICA_ALLOW_ANONYMOUS=true (development/test only).
# Production/staging require >= 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SEMANTICA_API_KEY=change-me-local-dev-key-change-me-local-dev-key

# Must stay false outside development/test (startup is refused otherwise).
SEMANTICA_ALLOW_ANONYMOUS=false

# FalkorDB (Railway: the FalkorDB service's private domain, e.g. falkordb.railway.internal)
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
# Required when SEMANTICA_ENV is production or staging (FalkorDB must run
# with --requirepass: the falkordb-server image has protected-mode off).
FALKORDB_PASSWORD=change-me-local-falkordb-password
# Optional; defaults to zeptly_semantica.
FALKORDB_GRAPH=zeptly_semantica
# Optional; socket connect/read timeout in seconds (default 5).
FALKORDB_TIMEOUT_SECONDS=5

# Railway injects PORT; local default is 8080.
# PORT=8080
